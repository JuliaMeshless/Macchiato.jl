# File generated by Pkg, the package manager, based on a corresponding Project.toml
# It records a fixed state of all packages used by the project. As such, it should not be
# committed for packages, but should be committed for applications that require a static
# environment.
Manifest.toml

# Mac related storage files
._.DS_Store
.DS_Store
._*

# Files generated by invoking Julia with --code-coverage
*.jl.cov
*.jl.*.cov

# Files generated by invoking Julia with --track-allocation
*.jl.mem

# System-specific files and directories generated by the BinaryProvider and BinDeps packages
# They contain absolute paths specific to the host computer, and so should not be committed
deps/deps.jl
deps/build.log
deps/downloads/
deps/usr/
deps/src/

# Build artifacts for creating documentation generated by the Documenter package
docs/build/
docs/site/
docs/node_modules/

# raw Thingiverse download consumed by examples/assets/prep_moka.py;
# only the processed moka.stl is committed
examples/assets/MokaPot.stl

# ignore media files
*.png
!docs/src/assets/*.png
!docs/src/public/*.png
*.mp4
*.gif

# ignore VSCode thingys
.vscode
*.code-workspace

# development
dev
CLAUDE.md
examples/niederer_benchmark/niederer_result.vtu
examples/niederer_benchmark/niederer_result_fd.vtr

# raw Stanford scan downloaded by examples/assets/prep_armadillo.py;
# only the processed armadillo.stl is committed
examples/assets/Armadillo.ply

# raw Bai et al. 2015 atlas mesh copied from DerangedIons/ArmyHeart.jl (git-LFS)
# by examples/assets/prep_biventricle.py; only the processed biventricle.stl is
# committed
examples/assets/bai_etal_2015-instance_010_e26073.vtu
examples/biventricle_result.vtu

# solved voltage frames for examples/biventricle_spiral.jl (re-renderable)
examples/biventricle_spiral_frames.jld2

# solved field for examples/helmholtz_cylinder.jl (re-renderable via
# examples/helmholtz_cylinder_viz.jl)
examples/helmholtz_cylinder_solution.jld2

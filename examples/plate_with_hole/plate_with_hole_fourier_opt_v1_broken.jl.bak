# ============================================================================
# Plate-with-hole — Fourier-mode shape optimization
#   raw gradient → Fourier mode projection → area-constrained step
#   → Helmholtz-smoothed boundary displacement → Laplace interior morphing
#
# The key insight: the per-node ℓ² gradient is Nyquist noise, but when
# contracted onto smooth Fourier modes (k=2..6), the noise integrates out.
# The Helmholtz filter provides mesh-independent spatial smoothing, and the
# Laplace equation ∇²(Δx)=0 morphs the interior smoothly.
#
# Run:  jlrun plate_with_hole/plate_with_hole_fourier_opt.jl   (from examples/)
# ============================================================================
using Pkg
Pkg.activate(joinpath(@__DIR__, ".."))

using Macchiato
import RadialBasisFunctions: _build_weights, Partial, MixedPartial, find_neighbors
using RadialBasisFunctions: PHS
using StaticArrays
using LinearAlgebra
using Printf
using CairoMakie

# ---- parameters ------------------------------------------------------------
const Lx        = 4.0
const Ly        = 4.0
const a0        = 0.40
const b0        = 0.20
const dx        = 0.05
const σ∞        = 1.0
const n_iter    = 40
const m_modes   = 2:6          # Fourier modes for shape parameterization
const helm_r    = 1.0           # Helmholtz filter radius (segment-count units)
const step_coef = 0.02          # dimensionless step size in Fourier space
const max_rms_disp_frac = 0.05  # clamp max RMS radial disp to this fraction of r₀

model   = LinearElasticity(E = 1.0e7, ν = 0.3)
μ, λstar = lame_parameters(model)
basis   = PHS(3; poly_deg = 3)
const k = 35

# ============================================================================
# Fourier radius parameterization
#   r(θ) = r₀ + Σ_{m in modes} [a_m·cos(mθ) + b_m·sin(mθ)]
#   x(θ) = r(θ)·cos(θ),  y(θ) = r(θ)·sin(θ)
# ============================================================================

function fourier_hole(r₀::Float64, a_coeffs::Vector{Float64},
                       b_coeffs::Vector{Float64}, θ::Vector{Float64},
                       modes::UnitRange{Int})
    nθ = length(θ)
    hole = Vector{SVector{2, Float64}}(undef, nθ)
    for j in 1:nθ
        r = r₀
        for (k, m) in enumerate(modes)
            r += a_coeffs[k] * cos(m * θ[j]) + b_coeffs[k] * sin(m * θ[j])
        end
        hole[j] = SVector(r * cos(θ[j]), r * sin(θ[j]))
    end
    return hole
end

function fourier_area(r₀::Float64, a_coeffs::Vector{Float64},
                       b_coeffs::Vector{Float64})
    osc = sum(abs2, a_coeffs) + sum(abs2, b_coeffs)
    return π * r₀^2 + (π / 2) * osc
end

function radial_component(g_hole::Vector{SVector{2,Float64}},
                           hole::Vector{SVector{2,Float64}})
    g_rad = Vector{Float64}(undef, length(g_hole))
    for j in eachindex(g_hole)
        g_rad[j] = (g_hole[j][1] * hole[j][1] + g_hole[j][2] * hole[j][2]) /
                    hypot(hole[j][1], hole[j][2])
    end
    return g_rad
end

function fourier_gradient(g_rad::Vector{Float64}, θ::Vector{Float64},
                           modes::UnitRange{Int})
    nθ = length(g_rad)
    dC_dr0 = sum(g_rad) / nθ
    n_modes = length(modes)
    dC_da = zeros(n_modes)
    dC_db = zeros(n_modes)
    for (k, m) in enumerate(modes)
        for j in 1:nθ
            dC_da[k] += g_rad[j] * cos(m * θ[j])
            dC_db[k] += g_rad[j] * sin(m * θ[j])
        end
        dC_da[k] *= 2.0 / nθ
        dC_db[k] *= 2.0 / nθ
    end
    return (dC_dr0 = dC_dr0, dC_da = dC_da, dC_db = dC_db)
end

function area_constrained_gradient(dC_dr0::Float64, dC_da::Vector{Float64},
                                    dC_db::Vector{Float64},
                                    a_coeffs::Vector{Float64},
                                    b_coeffs::Vector{Float64}, r₀::Float64)
    n = length(a_coeffs)
    dCda_A = similar(dC_da)
    dCdb_A = similar(dC_db)
    factor = dC_dr0 / (2.0 * r₀)
    for k in 1:n
        dCda_A[k] = dC_da[k] - factor * a_coeffs[k]
        dCdb_A[k] = dC_db[k] - factor * b_coeffs[k]
    end
    return (dCda_A = dCda_A, dCdb_A = dCdb_A)
end

function compute_initial_fourier(a::Float64, b::Float64, nθ::Int,
                                  modes::UnitRange{Int})
    θ = [2π * (j - 1) / nθ for j in 1:nθ]
    r_vals = [hypot(a * cos(t), b * sin(t)) for t in θ]
    n_modes = length(modes)
    a_coeffs = zeros(n_modes)
    b_coeffs = zeros(n_modes)
    r₀ = sum(r_vals) / nθ
    for j in 1:nθ
        r_dev = r_vals[j] - r₀
        for (k, m) in enumerate(modes)
            a_coeffs[k] += r_dev * cos(m * θ[j])
            b_coeffs[k] += r_dev * sin(m * θ[j])
        end
    end
    a_coeffs .*= 2.0 / nθ
    b_coeffs .*= 2.0 / nθ
    return (r₀ = r₀, a_coeffs = a_coeffs, b_coeffs = b_coeffs, θ = θ)
end

# ============================================================================
# Cloud generation — identical to ellipse optimizer, uses ellipse hole
# for the initial cloud. The Fourier representation is initialized from this
# hole and takes over from iteration 1 onward.
# ============================================================================

ellipse_val(p, a, b) = (p[1] / a)^2 + (p[2] / b)^2
const margin = 1 + 1.2 * dx / min(a0, b0)
const nθ = max(48, round(Int, 2π * sqrt((a0^2 + b0^2) / 2) / dx))

pts        = SVector{2, Float64}[]
base_tag   = Symbol[]
let xs = (-Lx / 2 + dx):dx:(Lx / 2 - dx / 2),
    ys = (-Ly / 2 + dx):dx:(Ly / 2 - dx / 2)
    for x in xs, y in ys
        ellipse_val(SVector(x, y), a0, b0) > margin^2 || continue
        push!(pts, SVector(x, y))
        push!(base_tag, :interior)
    end
end
for y in (-Ly / 2):dx:(Ly / 2)
    push!(pts, SVector(-Lx / 2, y)); push!(base_tag, :xlo)
    push!(pts, SVector(Lx / 2, y));  push!(base_tag, :xhi)
end
for x in (-Lx / 2 + dx):dx:(Lx / 2 - dx)
    push!(pts, SVector(x, Ly / 2));  push!(base_tag, :yhi)
    push!(pts, SVector(x, -Ly / 2)); push!(base_tag, :ylo)
end

# Initial hole: parametric ellipse (will be replaced by Fourier after iter 0)
hole0 = [SVector(a0 * cos(2π * j / nθ), b0 * sin(2π * j / nθ))
         for j in 0:(nθ - 1)]
append!(pts, hole0)
append!(base_tag, fill(:hole, nθ))

const N           = length(pts)
const n_fixed     = N - nθ  # interior + outer only
const hole_rng    = (n_fixed + 1):N
const hole_idx    = collect(hole_rng)

idx_of(t)         = findall(==(t), base_tag)
const interior_idx = idx_of(:interior)
const outer_idx    = vcat(idx_of(:xlo), idx_of(:xhi), idx_of(:yhi), idx_of(:ylo))
const neumann_idx  = vcat(outer_idx, hole_idx)

nearest(p0, pool) = pool[argmin([hypot(pts[i][1] - p0[1], pts[i][2] - p0[2])
                                  for i in pool])]
const pin_ux1      = nearest((0.0, 0.8), interior_idx)
const pin_ux2      = nearest((0.0, -0.8), interior_idx)
const pin_uy1      = nearest((0.8, 0.0), interior_idx)
const dirichlet_dofs = [pin_ux1, pin_ux2, pin_uy1 + N]
const active = let a = trues(2N)
    a[pin_ux1] = a[pin_ux2] = a[pin_uy1 + N] = false
    a
end
const interior_rows = let r = falses(N)
    for i in interior_idx; r[i] = true; end
    r
end

# ============================================================================
# Hole geometry utilities
# ============================================================================

hole_loop = collect(hole_rng)
hole_pos  = collect(1:length(hole_loop))
const _ZJV = SVector(0.0, 0.0)
zero_njac(g) = NormalJacobian(g, g, _ZJV, _ZJV, _ZJV, _ZJV)

function hole_polyline(hole_pts::Vector{SVector{2,Float64}})
    all_pts = vcat(pts[1:n_fixed], hole_pts)
    polyline_normals(reduce(vcat, [[p[1], p[2]] for p in all_pts]),
                     hole_loop, hole_pos)
end

outer_normal(i) = base_tag[i] === :xhi ? SVector(1.0, 0.0) :
                  base_tag[i] === :xlo ? SVector(-1.0, 0.0) :
                  base_tag[i] === :yhi ? SVector(0.0, 1.0) :
                  SVector(0.0, -1.0)

# ============================================================================
# Forward solve + shape gradient
# ============================================================================

function compute_gradient(pts_flat::Vector{Float64}, pts_vec,
                           adjl, neumann_adjl, hole_slice)
    hole_n, hole_jacs = hole_polyline(hole_slice)
    njacs = vcat(NormalJacobian[zero_njac(i) for i in outer_idx], hole_jacs)

    normals   = SVector{2, Float64}[]
    tractions = SVector{2, Float64}[]
    for i in outer_idx
        n = outer_normal(i)
        push!(normals, n)
        push!(tractions, σ∞ .* n)
    end
    append!(normals, hole_n)
    append!(tractions, fill(SVector(0.0, 0.0), length(hole_slice)))

    layout = build_traction_layout(neumann_idx, neumann_adjl, normals,
                                    tractions, λstar, μ, N)

    b = zeros(2N)
    for kk in eachindex(layout.rows)
        b[layout.rows[kk]] = layout.b_vals[kk]
    end

    res = shape_gradient(pts_flat, model, N, adjl, basis, active,
                         dirichlet_dofs, zeros(3), _ -> b;
                         interior_rows = interior_rows,
                         traction_layout = layout,
                         neumann_ids = neumann_idx,
                         neumann_adjl = neumann_adjl,
                         traction_jacobians = nothing,
                         normal_jacobians = njacs)

    C = dot(b, res.u)
    g_hole = [SVector(res.Δpts[2 * gi - 1], res.Δpts[2 * gi])
              for gi in hole_idx]
    return (C = C, g_hole = g_hole)
end

# ============================================================================
# Helmholtz filter — smooths displacement on the hole boundary loop.
# Solves (I - r²·Δ_1D_periodic) · f_smoothed = f_raw for x and y independently.
# Adapted from shape_optimization_phase3_cantilever.jl:463-492
# ============================================================================

function helmholtz_filter_displacement!(disp_flat::Vector{Float64},
                                          loop::Vector{Int};
                                          r::Float64 = 1.0)
    n_loop = length(loop)
    # Pre-build the (I - r²·Δ) matrix (same for x and y components)
    A = zeros(n_loop, n_loop)
    @inbounds for k in 1:n_loop
        k_prev = mod1(k - 1, n_loop)
        k_next = mod1(k + 1, n_loop)
        A[k, k_prev] = -r^2
        A[k, k]      = 1.0 + 2.0 * r^2
        A[k, k_next] = -r^2
    end
    fact_A = lu(A)

    for comp in (1, 2)  # x then y
        rhs = zeros(n_loop)
        @inbounds for k in 1:n_loop
            i_curr = loop[k]
            rhs[k] = disp_flat[2 * i_curr - 2 + comp]
        end
        f = fact_A \ rhs
        @inbounds for k in 1:n_loop
            i_curr = loop[k]
            disp_flat[2 * i_curr - 2 + comp] = f[k]
        end
    end
    return disp_flat
end

# ============================================================================
# Laplace interior morphing — solves ∇²(Δx) = 0 with Dirichlet BCs.
#   Hole boundary:  Δx = prescribed (from Fourier step + Helmholtz filter)
#   Outer boundary: Δx = 0
#   Interior:       ∇²(Δx) = 0
#
# System:  W_lap[I,I] · Δx_I = -W_lap[I,B] · Δx_B
# ============================================================================

function laplace_morph!(pts_flat::Vector{Float64},
                          pts_vec::Vector{SVector{2,Float64}},
                          adjl, basis,
                          interior_idx::Vector{Int},
                          boundary_idx::Vector{Int},
                          disp_flat::Vector{Float64})
    # Build Laplacian weights (∂²/∂x² + ∂²/∂y²)
    W_xx  = _build_weights(Partial(2, 1), pts_vec, pts_vec, adjl, basis)
    W_yy  = _build_weights(Partial(2, 2), pts_vec, pts_vec, adjl, basis)
    W_lap = W_xx + W_yy

    n_int = length(interior_idx)
    n_bnd = length(boundary_idx)

    # Interior block of Laplacian
    L_int     = W_lap[interior_idx, interior_idx]
    L_int_bnd = W_lap[interior_idx, boundary_idx]

    # Regularize slightly (RBF-FD Laplacian is not perfectly invertible)
    L_int_reg = L_int + 1e-8 * I

    fact_L = lu(L_int_reg)

    # Extract boundary displacements
    disp_bnd_x = [disp_flat[2 * j - 1] for j in boundary_idx]
    disp_bnd_y = [disp_flat[2 * j]     for j in boundary_idx]

    rhs_x = -L_int_bnd * disp_bnd_x
    rhs_y = -L_int_bnd * disp_bnd_y

    Δx_int = fact_L \ rhs_x
    Δy_int = fact_L \ rhs_y

    # Apply interior displacement
    @inbounds for (k, i) in enumerate(interior_idx)
        pts_flat[2 * i - 1] += Δx_int[k]
        pts_flat[2 * i]     += Δy_int[k]
    end

    # Apply boundary displacement (hole + outer)
    @inbounds for i in boundary_idx
        pts_flat[2 * i - 1] += disp_flat[2 * i - 1]
        pts_flat[2 * i]     += disp_flat[2 * i]
    end

    return nothing
end

# ============================================================================
# Initialize Fourier coefficients from the starting ellipse
# ============================================================================

f0 = compute_initial_fourier(a0, b0, nθ, m_modes)
r₀_cur    = f0.r₀
a_cur     = copy(f0.a_coeffs)
b_cur     = copy(f0.b_coeffs)
θ_vals    = copy(f0.θ)

const A_target = π * a0 * b0
const r_circle = sqrt(A_target / π)

# Adjust r₀ so the Fourier-reconstructed shape has the CORRECT area.
# The Fourier series is truncated (modes 2,4,6 only), so r₀ from the DFT
# fit gives the wrong area. We re-scale r₀ to match A_target exactly.
osc_init = (π / 2) * (sum(abs2, a_cur) + sum(abs2, b_cur))
r₀_cur = sqrt(max(0.0, (A_target - osc_init) / π))

# Verify initial Fourier representation
hole_f0 = fourier_hole(r₀_cur, a_cur, b_cur, θ_vals, m_modes)
A_init  = fourier_area(r₀_cur, a_cur, b_cur)
max_r_err = maximum(abs.(hypot.(getindex.(hole_f0, 1), getindex.(hole_f0, 2)) .-
                          hypot.(getindex.(hole0, 1),     getindex.(hole0, 2))))

println("=== Fourier-mode shape optimization ===\n")
println("Modes: $(collect(m_modes))  (nθ=$nθ, N=$N)")
println("Target: circle r=$(round(r_circle, digits=4))  (area=$(round(A_target, digits=6)))")
println("Helmholtz r=$helm_r  |  step_coef=$step_coef  |  max_rms_disp_frac=$max_rms_disp_frac")
println()
@printf("Initial Fourier fit:  r₀=%.4f  max radius error vs ellipse = %.2e\n", r₀_cur, max_r_err)
@printf("  Area: %.6f (target %.6f, err %.2e)\n", A_init, A_target, A_init - A_target)
println("\n  Initial Fourier coefficients:")
for (k, m) in enumerate(m_modes)
    @printf("    a_%d = %+.6f   b_%d = %+.6f\n", m, a_cur[k], m, b_cur[k])
end
println()

# ============================================================================
# Optimization loop — wrapped in let to avoid scoping issues with globals
# ============================================================================

pts_flat = reduce(vcat, [[p[1], p[2]] for p in pts])

let r₀_cur = r₀_cur, a_cur = a_cur, b_cur = b_cur,
    pts = pts, pts_flat = pts_flat

hist_C   = Float64[]
hist_a2  = Float64[]
hist_r0  = Float64[]
hist_area_err = Float64[]

@printf("%5s %10s %8s %8s %12s %12s %10s %10s\n",
        "iter", "C", "r₀", "a₂", "dC/dr₀", "dC/da₂|A", "step_rms", "area_err")
println("-"^90)

for it in 1:n_iter
    # ---- 1. Build adjacency from current point cloud ----
    adjl          = find_neighbors(pts, k)
    neumann_adjl  = adjl[neumann_idx]
    hole_slice    = pts[hole_idx]

    # ---- 2. Forward solve + shape gradient ----
    result = compute_gradient(pts_flat, pts, adjl, neumann_adjl, hole_slice)
    C      = result.C
    g_hole = result.g_hole

    # ---- 3. Record current state (before step) ----
    push!(hist_C, C)
    push!(hist_a2, a_cur[1])
    push!(hist_r0, r₀_cur)

    # ---- 4. Radial projection + Fourier decomposition ----
    g_rad = radial_component(g_hole, hole_slice)
    fg    = fourier_gradient(g_rad, θ_vals, m_modes)

    # ---- 5. Area-constrained gradient ----
    cg = area_constrained_gradient(fg.dC_dr0, fg.dC_da, fg.dC_db,
                                    a_cur, b_cur, r₀_cur)

    # ---- 6. Step size control ----
    grad_scale = max(abs(fg.dC_dr0), 1e-12)
    Δa_raw = -step_coef .* cg.dCda_A ./ grad_scale
    Δb_raw = -step_coef .* cg.dCdb_A ./ grad_scale

    rms_disp = sqrt(0.5 * (sum(abs2, Δa_raw) + sum(abs2, Δb_raw)))

    max_disp = max_rms_disp_frac * r₀_cur
    if rms_disp > max_disp
        scale  = max_disp / rms_disp
        Δa_raw .*= scale
        Δb_raw .*= scale
        rms_disp = max_disp
    end

    # ---- 7. Update Fourier coefficients ----
    a_new = a_cur + Δa_raw
    b_new = b_cur + Δb_raw

    # ---- 8. Enforce area constraint (adjust r₀) ----
    osc_part = (π / 2) * (sum(abs2, a_new) + sum(abs2, b_new))
    r₀_new = sqrt(max(0.0, (A_target - osc_part) / π))

    # ---- 9. Build new hole and displacement ----
    hole_new = fourier_hole(r₀_new, a_new, b_new, θ_vals, m_modes)
    Δhole    = [hole_new[j] - hole_slice[j] for j in 1:nθ]

    # ---- 10. Pack displacement into flat vector ----
    disp_flat = zeros(2N)
    @inbounds for (j, gi) in enumerate(hole_idx)
        disp_flat[2 * gi - 1] = Δhole[j][1]
        disp_flat[2 * gi]     = Δhole[j][2]
    end

    # ---- 11. Helmholtz filter on boundary displacement ----
    helmholtz_filter_displacement!(disp_flat, hole_idx; r = helm_r)

    # ---- 12. Laplace interior morphing ----
    boundary_idx = vcat(outer_idx, hole_idx)
    laplace_morph!(pts_flat, pts, adjl, basis, interior_idx,
                    boundary_idx, disp_flat)

    # ---- 13. Synchronize pts Vector from pts_flat ----
    @inbounds for i in 1:N
        pts[i] = SVector(pts_flat[2 * i - 1], pts_flat[2 * i])
    end

    # ---- 14. Advance Fourier state ----
    r₀_cur = r₀_new
    a_cur  = a_new
    b_cur  = b_new

    # ---- 15. Diagnostics ----
    area_now = fourier_area(r₀_cur, a_cur, b_cur)
    area_err = area_now - A_target
    push!(hist_area_err, area_err)

    @printf("%5d %10.5e %8.4f %8.4f %+12.4e %+12.4e %10.2e %10.2e\n",
            it, hist_C[end], r₀_cur, a_cur[1], fg.dC_dr0, cg.dCda_A[1],
            rms_disp, area_err)

    if rms_disp < 1e-8
        println("  Converged (step RMS < 1e-8).")
        break
    end
end

# ============================================================================
# Final state
# ============================================================================

println("\n--- Final state ---")
@printf("r₀:     %.4f → %.4f  (target circle: %.4f)\n", f0.r₀, r₀_cur, r_circle)
@printf("a₂:     %.4f → %.4f  (target: 0)\n", f0.a_coeffs[1], a_cur[1])
@printf("Area:   %.6f  (target: %.6f,  err: %.2e)\n",
        fourier_area(r₀_cur, a_cur, b_cur), A_target,
        length(hist_area_err) > 0 ? hist_area_err[end] : 0.0)
@printf("C:      %.4e (initial) →  (final C ≈ last recorded %.4e)\n",
        hist_C[1], hist_C[end])

println("\n  Final Fourier coefficients:")
for (k, m) in enumerate(m_modes)
    @printf("    a_%d = %+.6e   b_%d = %+.6e\n", m, a_cur[k], m, b_cur[k])
end

# ============================================================================
# Plotting
# ============================================================================

fig = Figure(size = (1200, 400))

# Panel 1: hole shapes
ax1 = Axis(fig[1, 1]; title = "Hole shapes", aspect = DataAspect(),
           xlabel = "x", ylabel = "y")
h_init = hole0
hx = [p[1] for p in h_init]; hy = [p[2] for p in h_init]
lines!(ax1, vcat(hx, hx[1]), vcat(hy, hy[1]);
       color = :red, linewidth = 2, label = "start (ellipse)")
h_final = pts[hole_idx]
hx = [p[1] for p in h_final]; hy = [p[2] for p in h_final]
lines!(ax1, vcat(hx, hx[1]), vcat(hy, hy[1]);
       color = :green, linewidth = 2, label = "final")
ts = range(0, 2π; length = 200)
lines!(ax1, r_circle .* cos.(ts), r_circle .* sin.(ts);
       color = :blue, linestyle = :dash, linewidth = 2, label = "target circle")
axislegend(ax1; position = :rb)

# Panel 2: dominant Fourier mode a₂
ax2 = Axis(fig[1, 2]; title = "Dominant mode a₂ → 0",
           xlabel = "iteration", ylabel = "a₂")
lines!(ax2, 0:length(hist_a2)-1, hist_a2; linewidth = 2)
hlines!(ax2, [0.0]; linestyle = :dash, color = :gray, label = "circle")
axislegend(ax2)

# Panel 3: compliance
ax3 = Axis(fig[1, 3]; title = "Compliance", xlabel = "iteration", ylabel = "C")
lines!(ax3, hist_C; linewidth = 2)
hlines!(ax3, [4.88e-5]; linestyle = :dash, color = :gray, label = "circle C (est)")

save(joinpath(@__DIR__, "plate_with_hole_fourier_opt.png"), fig)
println("\nSaved: plate_with_hole_fourier_opt.png")

end  # let block
